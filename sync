#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
agents_input="${SKILLS_AGENTS:-claude-code codex}"
read -r -a agents <<< "$agents_input"

if ! command -v gh >/dev/null 2>&1; then
  echo "GitHub CLI is required: https://cli.github.com/" >&2
  exit 1
fi

if ! gh skill --help >/dev/null 2>&1; then
  echo "GitHub CLI 2.90.0 or newer is required." >&2
  exit 1
fi

for agent in "${agents[@]}"; do
  echo "Syncing skills to ${agent}..."
  gh skill install "$repo_dir" \
    --from-local \
    --all \
    --agent "$agent" \
    --scope user \
    --force
done
